<?xml version="1.0" encoding="UTF-8"?>
<map>
    <config>
        <shape height="14" width="16"/>
        <cars max="125"/>

        <phase-config id="corridor-axis" forced-yellow-duration="2" forced-red-duration="1">
            <phase open-directions="north south" duration="10"/>
            <phase open-directions="east west" duration="8"/>
        </phase-config>
        <phase-config id="central-adaptive" forced-yellow-duration="2" forced-red-duration="1"
                      min-green-duration="3" max-green-duration="18">
            <phase open-directions="north" duration="dynamic"/>
            <phase open-directions="east" duration="dynamic"/>
            <phase open-directions="south" duration="dynamic"/>
            <phase open-directions="west" duration="dynamic"/>
        </phase-config>
        <phase-config id="outer-four-phase" forced-yellow-duration="3" forced-red-duration="2">
            <phase open-directions="north" duration="6"/>
            <phase open-directions="south" duration="6"/>
            <phase open-directions="east" duration="9"/>
            <phase open-directions="west" duration="9"/>
        </phase-config>
    </config>
    <nodes>
        <node id="WEST-GATE" x="0" y="7" type="spawn"/>
        <node id="EAST-GATE" x="15" y="7" type="destination"/>
        <node id="NORTH-GATE" x="8" y="0" type="spawn"/>
        <node id="SOUTH-GATE" x="8" y="13" type="destination"/>
        <node id="UPPER-STOP" x="6" y="3" type="spawn-destination"/>
        <node id="INNER-LOFT" x="4" y="5" type="spawn-destination"/>
        <node id="NORTH-MARKET" x="12" y="9" type="spawn-destination"/>
        <node id="SOUTH-MARKET" x="14" y="10" type="destination"/>
        <node id="JUNCTION-W" x="4" y="7" type="intersection" phase-config="corridor-axis"/>
        <node id="HUB" x="8" y="7" type="intersection" phase-config="central-adaptive"/>
        <node id="JUNCTION-E" x="12" y="7" type="intersection" phase-config="outer-four-phase"/>
        <node id="JUNCTION-N" x="8" y="3" type="intersection" phase-config="outer-four-phase"/>
        <node id="JUNCTION-S" x="8" y="10" type="intersection" phase-config="corridor-axis"/>
        <node id="JUNCTION-NW" x="4" y="3" type="intersection" phase-config="corridor-axis"/>
        <node id="JUNCTION-SE" x="12" y="10" type="intersection" phase-config="outer-four-phase"/>
    </nodes>
    <edges>
        <edge from="WEST-GATE" to="JUNCTION-W" type="two-way"/>
        <edge from="JUNCTION-W" to="HUB" type="two-way"/>
        <edge from="HUB" to="JUNCTION-E" type="two-way"/>
        <edge from="JUNCTION-E" to="EAST-GATE" type="two-way"/>
        <edge from="NORTH-GATE" to="JUNCTION-N" type="two-way"/>
        <edge from="JUNCTION-N" to="HUB" type="two-way"/>
        <edge from="HUB" to="JUNCTION-S" type="two-way"/>
        <edge from="JUNCTION-S" to="SOUTH-GATE" type="two-way"/>
        <edge from="JUNCTION-N" to="UPPER-STOP" type="two-way"/>
        <edge from="UPPER-STOP" to="JUNCTION-NW" type="two-way"/>
        <edge from="JUNCTION-NW" to="INNER-LOFT" type="two-way"/>
        <edge from="INNER-LOFT" to="JUNCTION-W" type="two-way"/>
        <edge from="JUNCTION-S" to="JUNCTION-SE" type="two-way"/>
        <edge from="JUNCTION-E" to="NORTH-MARKET" type="two-way"/>
        <edge from="NORTH-MARKET" to="JUNCTION-SE" type="two-way"/>
        <edge from="JUNCTION-SE" to="SOUTH-MARKET" type="two-way"/>
    </edges>
</map>
