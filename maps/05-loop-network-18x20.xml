        <edge from="JUNCTION-SW" to="WEST-ARCADE" type="two-way"/>
        <edge from="WEST-ARCADE" to="JUNCTION-NW" type="two-way"/>
        <edge from="JUNCTION-SW" to="SOUTH-WEST-DEPOT" type="two-way"/>
        <edge from="JUNCTION-CENTER" to="INNER-EAST" type="two-way"/>
        <edge from="INNER-EAST" to="JUNCTION-EAST" type="two-way"/>
        <edge from="JUNCTION-EAST" to="EAST-CENTER" type="two-way"/>
        <edge from="JUNCTION-EAST" to="EAST-ARCADE" type="two-way"/>
        <edge from="EAST-ARCADE" to="JUNCTION-SE" type="two-way"/>
        <edge from="JUNCTION-SE" to="EAST-SOUTH" type="two-way"/>
        <edge from="JUNCTION-SE" to="SOUTH-DEPOT" type="two-way"/>
        <edge from="JUNCTION-SE" to="BOTTOM-ARCADE" type="two-way"/>
        <edge from="BOTTOM-ARCADE" to="JUNCTION-SOUTH" type="two-way"/>
        <edge from="JUNCTION-SOUTH" to="SOUTH-CENTER" type="two-way"/>
        <edge from="JUNCTION-SOUTH" to="JUNCTION-CENTER" type="two-way"/>
    </edges>
</map>
