<?xml version="1.0" encoding="UTF-8"?>
<map>
    <!--
        A map consists of a configuration, named nodes, and straight road edges.
        Node coordinates use x = column and y = row, both starting at 0.
    -->
    <config>
        <!-- Positive grid dimensions. Every node must fit inside width x height. -->
        <shape height="12" width="12"/>
        <!-- Number of automatic vehicles the simulator will try to generate. -->
        <cars max="50"/>

        <!--
            Each phase-config defines a reusable traffic-light plan.
            Its id must be unique and is referenced by intersection nodes.
            forced-yellow-duration and forced-red-duration are positive
            transition times in seconds, applied when changing phases.
            min-green-duration and max-green-duration are optional positive
            limits for dynamic plans (defaults: 2 and 30 seconds).

            A configuration must use either fixed durations or dynamic
            durations for all its phases; do not mix the two modes.
        -->
        <phase-config id="4-phase" forced-yellow-duration="2" forced-red-duration="1">
            <!--
                open-directions accepts north, south, east, and/or west.
                Directions listed in one phase receive green together.
                duration is a positive number of seconds, or "dynamic".
                Dynamic phases use Max Pressure, considering movement queues
                and downstream occupancy; their green time is bounded by the
                min/max settings above. Make every phase dynamic to enable it.
            -->
            <phase open-directions="north" duration="dynamic"/>
            <phase open-directions="south" duration="dynamic"/>
            <phase open-directions="east" duration="dynamic"/>
            <phase open-directions="west" duration="dynamic"/>
        </phase-config>
        <phase-config id="2-phase" forced-yellow-duration="2" forced-red-duration="1">
            <phase open-directions="north south" duration="5"/>
            <phase open-directions="east west" duration="5"/>
        </phase-config>
    </config>

    <!--
        Each node needs a unique id and a unique grid coordinate.
        x is the column (0 to width-1); y is the row (0 to height-1).
        Types:
          spawn              generates vehicles; not a destination
          destination        destination only
          spawn-destination  both; preserves separate source/arrival behavior
          intersection       traffic-light junction; requires phase-config
    -->
    <nodes>
        <node id="S0" x="3" y="0" type="spawn"/>
        <node id="S1" x="0" y="4" type="spawn-destination"/>
        <node id="S2" x="11" y="4" type="spawn-destination"/>
        <node id="S3" x="3" y="11" type="spawn-destination"/>
        <node id="S4" x="0" y="8" type="destination"/>
        <node id="I0" x="3" y="4" type="intersection" phase-config="4-phase"/>
        <node id="I1" x="3" y="8" type="intersection" phase-config="2-phase"/>
    </nodes>

    <!--
        Edges connect declared node ids and must be horizontal or vertical.
        one-way travels from the "from" node toward the "to" node;
        two-way allows traffic in both directions. Intermediate grid cells
        are filled in automatically. Declare an intersection node wherever
        roads meet; incompatible crossings or overlaps are rejected.
    -->
    <edges>
        <edge from="S0" to="I0" type="two-way"/>
        <edge from="S1" to="I0" type="two-way"/>
        <edge from="S2" to="I0" type="two-way"/>
        <edge from="S3" to="I0" type="two-way"/>
        <edge from="S4" to="I1" type="two-way"/>
        <edge from="I0" to="I1" type="two-way"/>
        <edge from="S3" to="I1" type="two-way"/>
    </edges>
</map>
